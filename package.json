{
  "name": "tb-follow-local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8.8.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:all": "node scripts/start.mjs",
    "build": "pnpm --dir frontend build",
    "preview": "node scripts/start.mjs --preview",
    "mock:check": "pnpm --dir mock-api test",
    "check": "pnpm mock:check && pnpm build",
    "install:all": "pnpm --dir frontend install --frozen-lockfile && pnpm --dir mock-api install --frozen-lockfile"
  }
}
